{
  "manifest_version": 3,
  "name": "清大 OAuth 驗證碼自動填入",
  "version": "1.0.0",
  "description": "在清大校務資訊系統 OAuth 登入頁辨識並填入驗證碼。只作用於 oauth.ccxp.nthu.edu.tw，不會讀取或送出帳號密碼。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://oauth.ccxp.nthu.edu.tw/v1.1/authorize.php*"],
      "js": [
        "vendor/tfjs-core.min.js",
        "vendor/tfjs-backend-webgl.min.js",
        "vendor/tfjs-layers.min.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["model/*"],
      "matches": ["https://oauth.ccxp.nthu.edu.tw/*"]
    }
  ]
}
